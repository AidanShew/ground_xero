function scr_global_enums(){
	enum MOVE {
		RIVER,
		DICE,
		ORBIT,
		CORNER,
		ROAD,
		
		//SWOOP
		SWOOP_LEFT,
		SWOOP_RIGHT,
		
		//TRIO
		TRIO,
		TRIO_LEFT,
		TRIO_RIGHT,
		
		//HELIX
		HELIX,
		HELIX_LEFT,
		HELIX_RIGHT,
		
		//CROSS
		CROSS_LEFT,
		CROSS_RIGHT,
		
		//CIRCUIT
		CIRCUIT,
		CIRCUIT_LEFT,
		CIRCUIT_RIGHT,
		TARGET,
		TEST,
		
		//PACK
		PACK,
		PACK_RIGHT,
		PACK_LEFT,
		
		//REVOLVER
		REVOLVER_LEFT,
		REVOLVER_RIGHT,
		
		SINGLE_SPIRAL,
		DOUBLE_SPIRAL
	}
	
	enum TRACER_MOVE {
		//FROM TOP
		FROM_TOP_LEFT,
		FROM_TOP_RIGHT,
		FROM_TOP_CENTER,
		
		//FROM BOTTOM
		FROM_BOTTOM_LEFT,
		FROM_BOTTOM_RIGHT,
		FROM_BOTTOM_CENTER,
		
		FROM_LEFT,
		FROM_RIGHT
	}
	
	enum TRACER_ALIGN {
		LEFT,
		RIGHT
	}
	
	enum BOSS {
		TRECLOPS
	}
	
	enum TRECLOPS_ATTACK {
		HAND_SWOOP, //0
		BULLET_STAR, //1
		SIDE_SPREAD, //2
		PARTIAL_SPREAD, //3 
		NONE, //4
		CALIBRATE, //5
		CALIBRATE_ONE,
		CALIBRATE_TWO,
		STAR,
		PARTIAL_RAIN, //9
		FULL_RAIN,
		SHIELD, //11
		BLOCK,
		DESPERATE // Star+Spread
	}
	
	enum TRECLOPS_PHASE {
		ONE,
		TWO,
		THREE, //SHEILD
		FOUR, //BLOCK
		FIVE //DESPERATION
	}
	
	enum ATTACK {
		MINEFIELD,
		CAKE,
		SPREAD,
		SPIRAL,
		AIMED
	}
	
	enum MINE_ALIGNMENT {
		NONE,
		LEFT,
		RIGHT,
		CENTER
	}

	enum SECTION {
		ONE, //SWOOP
		TWO, //TRIO
		THREE, //CROSS
		FOUR, //DOUBLE SPIRAL
		FIVE, //CROSS
		SIX, //CIRCUIT
		SEVEN, //SINGLE SPIRAL
		EIGHT, //REVOLVER
		NINE, //PACK
		TEN, //LADDER
		ELEVEN //TRECLOPS
	}
}